(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad r105_70
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 70000)
            (height 105000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad r70_52
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 52000)
            (height 70000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack r105_70
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r105_70))
          (noconnect (pad r105_70))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r105_70))
          (noconnect (pad r105_70))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r105_70))
          (noconnect (pad r105_70))
        )
      )
      (padstack r70_52
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r70_52))
          (noconnect (pad r70_52))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r70_52))
          (noconnect (pad r70_52))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r70_52))
          (noconnect (pad r70_52))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "DSN2_1"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -80000 40000
                        (width 20000)
                      )
                      (pt 80000 40000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 80000 40000
                        (width 20000)
                      )
                      (pt 80000 -40000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 80000 -40000
                        (width 20000)
                      )
                      (pt -80000 -40000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -80000 -40000
                        (width 20000)
                      )
                      (pt -80000 40000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CW
                        (r 1000)
                        (begin
                          (pt -108600 3200
                            (width 20000)
                          )
                        )
                        (center 0 0)
                        (end
                          (pt -108600 3200
                            (width 20000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin 1
            (pt -59000 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -59000 0)
                  (angle 0)
                  (padstackGroup default (padstack r70_52))
                )
              )
            )
          )
          (pin 2
            (pt 32500 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 32500 0)
                  (angle 90)
                  (padstackGroup default (padstack r105_70))
                )
              )
            )
          )
        ); End of toeprint
        (propertyS accurateShape NSR20F30NXT5G.stp)
      ); End of footprint
    ); End of footprints
  );  End of footprintContainer
); End of ftf

