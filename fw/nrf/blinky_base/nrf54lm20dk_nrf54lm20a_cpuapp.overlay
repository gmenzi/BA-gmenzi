/*
 * Own-board signals on the nRF54LM20 DK.
 * P2 has no GPIOTE, so interrupt inputs must stay on P0, P1 or P3.
 */

/ {
	/* M7: PPG_NEW_APPL.C USES DEVICE_DT_GET(DT_ALIAS(I2CB)), AS IN BIOGAP. */
	aliases {
		i2cb = &i2c21;
	};

	patch_outputs {
		compatible = "gpio-leds";

		link_ready: link_ready {
			gpios = <&gpio2 6 GPIO_ACTIVE_HIGH>;
			label = "LINK_READY to MSP P5.7";
		};

		uups_trig: uups_trig {
			gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;
			label = "UUPS_TRIG_IN to MSP P1.7";
		};

		ppg_sync: ppg_sync {
			gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;
			label = "PPG_GPIO sync";
		};

		/* M7: BIOGAP'S PPG_DEBUG TOGGLE OUTPUT. ON THE DK IT GOES TO LED2
		 * (P1.27), SO IT BLINKS EVERY 100 PPG SAMPLES. THE OWN BOARD HAS
		 * NO SUCH PIN: USE A SPARE PIN OR TEST POINT THERE. */
		ppg_debug: ppg_debug {
			gpios = <&gpio1 27 GPIO_ACTIVE_HIGH>;
			label = "PPG debug toggle (DK LED2)";
		};
	};

	patch_inputs {
		compatible = "gpio-leds";

		data_ready: data_ready {
			gpios = <&gpio1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			label = "DATA_READY from MSP P6.0";
		};

		/* M7: LABEL RENAMED FROM PPG_INT TO PPG_INTB, THE NAME BIOGAP'S
		 * PPG_NEW_APPL.C EXPECTS. SAME PIN AS BEFORE. */
		ppg_intb: ppg_intb {
			gpios = <&gpio1 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "PPG_INT, BUTTON1 on the DK";
		};

		pmic_irq: pmic_irq {
			gpios = <&gpio0 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "PMIC_IRQ, BUTTON3 on the DK";
		};
	};
};

/* Creates a virtual serial port on the nRF's USB connector. */
&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "Patch data link";
	};
};

/*
 * DK only: the onboard flash shares SPI00 and uses P2.05 as CS.
 * Remove the flash node, keep P2.05 high, and use P1.13 as CS.
 * On the own board: remove the &gpio2 block and use P2.05 as CS.
 * WICHTIG: auf DK funktioniert port 2 nicht für SPI (MISO, MOSI) das fürs eigene board aber wieder zurücksetzen. -> &spi00
 */
/delete-node/ &mx25r64;

&gpio2 {
	dk_flash_cs_idle {
		gpio-hog;
		gpios = <5 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

&spi22 {
	status = "okay";
	cs-gpios = <&gpio1 13 GPIO_ACTIVE_LOW>;

	msp430: msp430@0 {
		compatible = "vnd,spi-device";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(8)>;
	};
};

/*
 * M7: I2C TO THE MAXM86161.
 * DK: TWIM21 ON P1.07 (SCL) AND P1.06 (SDA), BOTH ON THE DK'S PIN HEADER.
 *  - NOT TWIM20: IT SHARES ITS HARDWARE WITH UART20, THE DK'S LOG CONSOLE.
 *  - NOT TWIM22: IT SHARES ITS HARDWARE WITH SPI22, USED FOR THE MSP ABOVE.
 *  - NOT P1.28 FOR SDA (OWN-BOARD PIN): ON THE DK IT DRIVES LED3.
 * OWN BOARD: SCL P1.07, SDA P1.28 (SEE PINBELEGUNG_MSP_NRF.XLSX).
 * BIAS-PULL-UP TURNS ON THE NRF'S WEAK INTERNAL PULL-UPS. THEY ARE ONLY A
 * FALLBACK: THE PPG BOARD SHOULD HAVE ITS OWN PULL-UP RESISTORS.
 */
&pinctrl {
	i2c21_default: i2c21_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 7)>,
				<NRF_PSEL(TWIM_SDA, 1, 6)>;
			bias-pull-up;
		};
	};

	i2c21_sleep: i2c21_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 7)>,
				<NRF_PSEL(TWIM_SDA, 1, 6)>;
			low-power-enable;
		};
	};
};

&i2c21 {
	status = "okay";
	pinctrl-0 = <&i2c21_default>;
	pinctrl-1 = <&i2c21_sleep>;
	pinctrl-names = "default", "sleep";
	/* M7: 400 KHZ. THE MAXM86161 SUPPORTS FAST MODE. but only with pukkups.  */
	clock-frequency = <I2C_BITRATE_STANDARD>;
};
